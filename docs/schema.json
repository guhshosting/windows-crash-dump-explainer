{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "title":"windows-crash-dump-explainer 1.0.0 report",
 "type":"object","additionalProperties":false,
 "required":["schema_version","tool_version","exit_code","status","error","dump","system","process","exception","exception_location","threads","extended_threads","modules","unloaded_modules","memory","comments","findings","warnings","unavailable_data"],
 "properties":{
  "schema_version":{"const":"1.0.0"},"tool_version":{"const":"1.0.0"},
  "exit_code":{"type":"integer","minimum":0,"maximum":4},"status":{"enum":["complete","partial","error"]},"error":{"type":["null","string"]},
  "dump":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/dump"}]},
  "system":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/system"}]},
  "process":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/process"}]},
  "exception":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/exception"}]},
  "exception_location":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/location"}]},
  "threads":{"type":"array","items":{"$ref":"#/definitions/thread"}},
  "extended_threads":{"type":"array","items":{"$ref":"#/definitions/thread"}},
  "modules":{"type":"array","items":{"$ref":"#/definitions/module"}},
  "unloaded_modules":{"type":"array","items":{"$ref":"#/definitions/unloaded"}},
  "memory":{"type":"array","items":{"$ref":"#/definitions/memory"}},
  "comments":{"$ref":"#/definitions/strings"},"findings":{"$ref":"#/definitions/strings"},"warnings":{"$ref":"#/definitions/strings"},"unavailable_data":{"$ref":"#/definitions/strings"}
 },
 "allOf":[
  {"if":{"properties":{"exit_code":{"const":0}}},"then":{"properties":{"status":{"const":"complete"},"error":{"type":"null"}}}},
  {"if":{"properties":{"exit_code":{"const":1}}},"then":{"properties":{"status":{"const":"partial"},"error":{"type":"null"}}}},
  {"if":{"properties":{"exit_code":{"minimum":2}}},"then":{"properties":{"status":{"const":"error"},"error":{"type":"string"},"dump":{"type":"null"},"system":{"type":"null"},"process":{"type":"null"},"exception":{"type":"null"},"exception_location":{"type":"null"},"threads":{"maxItems":0},"extended_threads":{"maxItems":0},"modules":{"maxItems":0},"unloaded_modules":{"maxItems":0},"memory":{"maxItems":0}}}}
 ],
 "definitions":{
  "uint":{"type":"integer","minimum":0,"maximum":4294967295},
  "nullable_uint":{"type":["integer","null"],"minimum":0,"maximum":4294967295},
  "hex":{"type":"string","pattern":"^0x[0-9a-f]{16}$"},
  "decimal":{"type":"string","pattern":"^(0|[1-9][0-9]*)$"},
  "strings":{"type":"array","items":{"type":"string"}},
  "dump":{"type":"object","additionalProperties":false,"required":["size_bytes","format_version","timestamp_unix","flags","checksum","streams","full_memory_requested"],"properties":{
   "size_bytes":{"type":"integer","minimum":32,"maximum":268435456},"format_version":{"$ref":"#/definitions/uint"},"timestamp_unix":{"$ref":"#/definitions/uint"},"flags":{"$ref":"#/definitions/hex"},"checksum":{"$ref":"#/definitions/uint"},"full_memory_requested":{"type":"boolean"},
   "streams":{"type":"array","maxItems":4096,"items":{"type":"object","additionalProperties":false,"required":["type","size","rva"],"properties":{"type":{"$ref":"#/definitions/uint"},"size":{"$ref":"#/definitions/uint"},"rva":{"$ref":"#/definitions/uint"}}}}
  }},
  "system":{"type":"object","additionalProperties":false,"required":["architecture","architecture_id","processor_count","product_type","major","minor","build","platform_id","suite_mask","service_pack"],"properties":{
   "architecture":{"type":"string"},"architecture_id":{"type":"integer","minimum":0,"maximum":65535},"processor_count":{"type":"integer","minimum":0,"maximum":255},"product_type":{"type":"integer","minimum":0,"maximum":255},"major":{"$ref":"#/definitions/uint"},"minor":{"$ref":"#/definitions/uint"},"build":{"$ref":"#/definitions/uint"},"platform_id":{"$ref":"#/definitions/uint"},"suite_mask":{"type":"integer","minimum":0,"maximum":65535},"service_pack":{"type":"string"}
  }},
  "process":{"type":"object","additionalProperties":false,"required":["flags","process_id","process_create_time_unix","user_time_seconds","kernel_time_seconds"],"properties":{
   "flags":{"$ref":"#/definitions/hex"},"process_id":{"$ref":"#/definitions/nullable_uint"},"process_create_time_unix":{"$ref":"#/definitions/nullable_uint"},"user_time_seconds":{"$ref":"#/definitions/nullable_uint"},"kernel_time_seconds":{"$ref":"#/definitions/nullable_uint"}
  }},
  "exception":{"type":"object","additionalProperties":false,"required":["thread_id","code","name","description","flags","address","record_address","context_bytes","parameters"],"properties":{
   "thread_id":{"$ref":"#/definitions/uint"},"code":{"$ref":"#/definitions/hex"},"name":{"type":"string"},"description":{"type":"string"},"flags":{"$ref":"#/definitions/hex"},"address":{"$ref":"#/definitions/hex"},"record_address":{"$ref":"#/definitions/hex"},"context_bytes":{"$ref":"#/definitions/uint"},"parameters":{"type":"array","maxItems":15,"items":{"$ref":"#/definitions/hex"}},"memory_operation":{"enum":["read","write","execute","unknown"]},"referenced_address":{"$ref":"#/definitions/hex"},"fast_fail_subcode":{"$ref":"#/definitions/hex"}
  }},
  "location":{"type":"object","additionalProperties":false,"required":["module_paths","ambiguous"],"properties":{"module_paths":{"$ref":"#/definitions/strings"},"ambiguous":{"type":"boolean"}}},
  "thread":{"type":"object","additionalProperties":false,"required":["id","suspend_count","priority_class","priority","teb","stack_base","stack_bytes","context_bytes"],"properties":{
   "id":{"$ref":"#/definitions/uint"},"suspend_count":{"$ref":"#/definitions/uint"},"priority_class":{"$ref":"#/definitions/uint"},"priority":{"$ref":"#/definitions/uint"},"teb":{"$ref":"#/definitions/hex"},"stack_base":{"$ref":"#/definitions/hex"},"stack_bytes":{"$ref":"#/definitions/uint"},"context_bytes":{"$ref":"#/definitions/uint"}
  }},
  "version":{"type":["string","null"],"pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$"},
  "module":{"type":"object","additionalProperties":false,"required":["base","size","path","name","checksum","timestamp_unix","file_version","product_version"],"properties":{
   "base":{"$ref":"#/definitions/hex"},"size":{"$ref":"#/definitions/uint"},"path":{"type":"string"},"name":{"type":"string"},"checksum":{"$ref":"#/definitions/uint"},"timestamp_unix":{"$ref":"#/definitions/uint"},"file_version":{"$ref":"#/definitions/version"},"product_version":{"$ref":"#/definitions/version"}
  }},
  "unloaded":{"type":"object","additionalProperties":false,"required":["base","size","path","name","checksum","timestamp_unix"],"properties":{
   "base":{"$ref":"#/definitions/hex"},"size":{"$ref":"#/definitions/uint"},"path":{"type":"string"},"name":{"type":"string"},"checksum":{"$ref":"#/definitions/uint"},"timestamp_unix":{"$ref":"#/definitions/uint"}
  }},
  "memory":{"type":"object","additionalProperties":false,"required":["stream_type","range_count"],"properties":{"stream_type":{"enum":[5,9,16]},"range_count":{"type":"integer","minimum":0,"maximum":100000},"captured_bytes":{"$ref":"#/definitions/decimal"},"described_bytes":{"$ref":"#/definitions/decimal"}},"oneOf":[{"required":["captured_bytes"]},{"required":["described_bytes"]}]}
 }
}
